{
  "name": "@flatwalk/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./schemas/*": "./schemas/*" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "schema:generate": "node --import tsx scripts/generate.ts",
    "schema:check": "node --import tsx scripts/generate.ts --check",
    "test:python": "python3 python/check_corpus.py",
    "validate": "node --import tsx scripts/validate.ts"
  },
  "dependencies": { "zod": "4.1.5" },
  "devDependencies": { "@types/node": "22.18.1", "tsx": "4.20.5", "typescript": "5.9.2" }
}
