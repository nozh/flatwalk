# Copy to the repository `.env` (gitignored) or export in the shell.
# Do not commit values. Live mode is explicit: FLATWALK_ADAPTERS=live

# fixture (default) | live
FLATWALK_ADAPTERS=fixture

# x.ai — https://docs.x.ai/  Authorization: Bearer
XAI_API_KEY=

# Optional override; default grok-4.6 from current x.ai docs. Availability is proven by GET /v1/language-models, not by this name.
# grok-4.6 is a reasoning model (reasoning_effort defaults to high). grok-rects sets reasoning_effort=low.
# XAI_MODEL=grok-4.6

# fal — https://fal.ai/models/fal-ai/hunyuan_world/api  Authorization: Key
FAL_KEY=
