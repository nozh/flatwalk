{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "modelId": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "walkReady": {
      "type": "boolean"
    },
    "confirmation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "enum": [
              "sources",
              "contract",
              "geometry",
              "consistency",
              "navigation",
              "scale",
              "assets",
              "evidence"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unverified",
              "skipped"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*)*$(?![\\s\\S])"
            }
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "0.1"
              },
              "modelId": {
                "type": "string",
                "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
              },
              "baseRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "ops": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "set"
                        },
                        "path": {
                          "type": "string",
                          "allOf": [
                            {
                              "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*)*$(?![\\s\\S])"
                            },
                            {
                              "pattern": "^(?:flat|plan|vertices|walls|openings|rooms|assets)(?:\\.|$)"
                            }
                          ]
                        },
                        "value": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": [
                        "op",
                        "path",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "unset"
                        },
                        "path": {
                          "type": "string",
                          "allOf": [
                            {
                              "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*)*$(?![\\s\\S])"
                            },
                            {
                              "pattern": "^(?:flat|plan|vertices|walls|openings|rooms|assets)(?:\\.|$)"
                            }
                          ]
                        }
                      },
                      "required": [
                        "op",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "schemaVersion",
              "modelId",
              "baseRevision",
              "module",
              "ops"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "checkId",
          "layer",
          "status",
          "severity",
          "entities",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.(?!(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_][A-Za-z0-9_-]*)*$(?![\\s\\S])"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "suggestion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path",
              "severity",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "modelId",
    "revision",
    "walkReady",
    "confirmation",
    "checks",
    "review"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://flatwalk.local/contract/0.1/ValidationReport.schema.json",
  "title": "ValidationReport",
  "description": "Generated from Zod. Full validation also requires semantic-rules.json and the contract runtime."
}
